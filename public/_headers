# Cloudflare Pages headers.
#
# The noindex block below must stay while the site is on maarefa.pages.dev.
# Removing it is part of attaching the real domain (PROMPTS.md Prompt 5, step 7)
# and must happen in the same change as pointing SITE_URL at that domain.
# See docs/ADDENDUM-hosting.md.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
