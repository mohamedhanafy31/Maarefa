---
/**
 * src/pages/rust/index.astro — Rust track overview
 *
 * Lists all six modules with their lessons. Lessons that exist in content/
 * as published entries render as links. Lessons not yet written render as
 * plain text "قادم قريباً" — NOT a link (PLAN.md §3, CURRICULUM.md §3).
 *
 * The full curriculum is hardcoded from CURRICULUM.md §2 and PLAN.md §2 with
 * anticipated slugs (see report item 4 for decision notes). When a lesson is
 * written and its slug matches the anticipated one, it automatically becomes
 * a link on the next build.
 *
 * Modules 3–5 are entirely future scope; all their entries show "قادم قريباً".
 *
 * No client JavaScript. No hydration. Pure build-time rendering.
 */

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';


// ── The shape of the whole track ────────────────────────────────────────────
//
// This array holds ONLY the lessons that are not written yet. Published lessons
// are read from the collection, so a slug can never drift between the two.
//
// It used to list every lesson including the written ones, and that produced a
// silent bug of exactly the kind this file is prone to: it carried
// `install` / `editor-setup` while the frontmatter said
// `install-rust` / `setup-editor`, so two finished lessons rendered as
// "قادم قريباً" with no error anywhere. A hardcoded copy of data that also
// exists in content/ will drift; the fix is to not keep the copy.
//
// Titles here come from CURRICULUM.md §2. Slugs are ANTICIPATED — when the
// lesson is written, whatever slug its frontmatter declares wins, and the entry
// below simply stops matching and drops out.
//
// Unwritten lessons are appended after the published ones, which yields the
// right order for every module in the current curriculum: module 1 has 1.4
// last, module 2 has 2.3–2.5 last, modules 3–5 are entirely unwritten.

type CurriculumLesson = { title: string; slug: string };
type CurriculumModule = {
  id: string;
  titleAr: string;
  titleEn: string;
  /** Not yet written. Rendered as plain text with a قادم قريباً badge. */
  upcoming: CurriculumLesson[];
};

const CURRICULUM: CurriculumModule[] = [
  {
    id: 'getting-started',
    titleAr: 'البداية',
    titleEn: 'Getting Started',
    upcoming: [],
  },
  {
    id: 'foundations',
    titleAr: 'الأساسيات',
    titleEn: 'Foundations',
    // 1.4 deferred to period 2 (CLAUDE.md C1, CURRICULUM.md §3).
    upcoming: [{ title: 'التحكم في المسار', slug: 'control-flow' }],
  },
  {
    id: 'ownership',
    titleAr: 'الملكية',
    titleEn: 'Ownership',
    upcoming: [
      { title: 'الاستعارة', slug: 'borrow' },
      { title: 'الاستعارة القابلة للتغيير', slug: 'borrow-mut' },
      { title: 'الشرائح', slug: 'slices' },
    ],
  },
  {
    id: 'structuring',
    titleAr: 'البنى',
    titleEn: 'Structuring Data',
    upcoming: [
      { title: 'الـ Structs', slug: 'structs' },
      { title: 'الـ Enums', slug: 'enums' },
      { title: 'مطابقة الأنماط', slug: 'pattern-matching' },
      { title: 'Option', slug: 'option' },
      { title: 'Result ومعالجة الأخطاء', slug: 'result-error-handling' },
    ],
  },
  {
    id: 'abstraction',
    titleAr: 'التجريد',
    titleEn: 'Generics, Traits, Lifetimes',
    upcoming: [
      { title: 'الأنواع العامة', slug: 'generics' },
      { title: 'السمات', slug: 'traits' },
      { title: 'دورات الحياة', slug: 'lifetimes' },
      { title: 'الإرسال الساكن مقابل الديناميكي', slug: 'static-vs-dynamic' },
    ],
  },
  {
    id: 'practical',
    titleAr: 'Rust عملي',
    titleEn: 'Practical Rust',
    upcoming: [
      { title: 'المجموعات', slug: 'collections' },
      { title: 'أنماط معالجة الأخطاء', slug: 'error-patterns' },
      { title: 'الوحدات والحزم', slug: 'modules-packages' },
      { title: 'الاختبارات', slug: 'testing' },
      { title: 'التجريدات صفرية التكلفة', slug: 'zero-cost-abstractions' },
    ],
  },
];

// ── Merge: published entries first (authoritative), then the unwritten ──────
// Draft entries (published:false) appear in NEITHER list — they are excluded
// from every index (PLAN.md §4 rule 5).

const allLessons = await getCollection('lessons');

const publishedByModule = new Map<string, typeof allLessons>();
for (const l of allLessons) {
  if (!l.data.published) continue;
  const list = publishedByModule.get(l.data.module) ?? [];
  list.push(l);
  publishedByModule.set(l.data.module, list);
}
for (const list of publishedByModule.values()) {
  list.sort((a, b) => a.data.order - b.data.order);
}

const modules = CURRICULUM.map((mod) => {
  const live = (publishedByModule.get(mod.id) ?? []).map((l) => ({
    title: l.data.title,
    slug: l.data.slug,
    isLive: true,
  }));
  const liveSlugs = new Set(live.map((l) => l.slug));
  const soon = mod.upcoming
    .filter((u) => !liveSlugs.has(u.slug))
    .map((u) => ({ ...u, isLive: false }));
  return { ...mod, lessons: [...live, ...soon] };
});


function lessonUrl(moduleId: string, slug: string): string {
  return `/rust/${moduleId}/${slug}/`;
}

const pageTitle = 'مسار Rust';
const pageDescription =
  'مسار تعليمي عربي شامل لـ Rust — من الصفر حتى الملكية والتجريد، مع بصريات للذاكرة وأسمبلي حقيقي.';
---

<Base title={pageTitle} description={pageDescription}>
  <main class="wrap" id="main">
    <header class="track-header">
      <h1>مسار <span dir="ltr">Rust</span></h1>
      <p class="track-tagline">
        من لا شيء مثبَّت إلى فهم الـ ownership — وهي النقطة التي يقرر عندها
        معظم الناس الاستمرار أو الاستسلام.
      </p>
    </header>

    <div class="modules-list">
      {modules.map((mod, modIdx) => (
        <section class="module-card" aria-labelledby={`module-${mod.id}-heading`}>
          <header class="module-card-header">
            <!-- Western numeral for module number (CLAUDE.md C2) -->
            <span class="module-number" dir="ltr" aria-hidden="true">
              {String(modIdx).padStart(2, '0')}
            </span>
            <div class="module-card-titles">
              <h2 id={`module-${mod.id}-heading`} class="module-title-ar">
                {mod.titleAr}
              </h2>
              <p class="module-title-en" dir="ltr">{mod.titleEn}</p>
            </div>
          </header>

          <ol class="lesson-list">
            {mod.lessons.map((lesson, lessonIdx) => {
              const isLive = lesson.isLive;
              return (
                <li class={`lesson-item ${isLive ? 'lesson-live' : 'lesson-soon'}`}>
                  <!-- Western numeral for lesson position -->
                  <span class="lesson-num" dir="ltr" aria-hidden="true">
                    {lessonIdx + 1}
                  </span>
                  {isLive ? (
                    <a
                      href={lessonUrl(mod.id, lesson.slug)}
                      class="lesson-link"
                    >
                      {lesson.title}
                    </a>
                  ) : (
                    <span class="lesson-title-text">
                      {lesson.title}
                      <span class="coming-soon-badge">قادم قريباً</span>
                    </span>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </main>
</Base>

<style>
  /* ── Page header ─────────────────────────────────────────────────── */
  .track-header {
    margin-block-end: var(--sp-8);
  }

  .track-tagline {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    margin-block-start: var(--sp-3);
    max-inline-size: var(--measure);
  }

  /* ── Module grid ─────────────────────────────────────────────────── */
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-block-end: var(--sp-10);
  }

  /* ── Module card ─────────────────────────────────────────────────── */
  .module-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-ui);
    overflow: hidden;
  }

  .module-card-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface);
    border-block-end: 1px solid var(--border);
  }

  .module-number {
    font-family: var(--font-mono);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--accent);
    opacity: 0.6;
    flex-shrink: 0;
    line-height: 1;
  }

  .module-card-titles { flex: 1; min-inline-size: 0; }

  .module-title-ar {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .module-title-en {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-block-start: var(--sp-1);
  }

  /* ── Lesson list ─────────────────────────────────────────────────── */
  .lesson-list {
    list-style: none;
    margin: 0;
    padding: var(--sp-2) 0;
  }

  .lesson-item {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    padding-inline: var(--sp-5);
    padding-block: var(--sp-3);
    border-block-end: 1px solid var(--border);
  }

  .lesson-item:last-child { border-block-end: 0; }

  .lesson-num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs, 0.75rem);
    color: var(--text-muted);
    min-inline-size: 1.4ch;
    flex-shrink: 0;
  }

  .lesson-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lesson-link:hover { color: var(--accent); }

  .lesson-title-text {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .coming-soon-badge {
    font-size: var(--fs-xs, 0.75rem);
    padding-inline: var(--sp-2);
    padding-block: 0.15em;
    border: 1px solid var(--border);
    border-radius: 99px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .module-card-header { padding: var(--sp-3) var(--sp-4); }
    .lesson-item { padding-inline: var(--sp-4); }
    .module-number { font-size: var(--fs-xl); }
  }
</style>
