---
/**
 * Lesson 1.3 — the semicolon, traced.
 *
 * The whole lesson is one distinction, and this is it: the same body compiles
 * or fails depending on a single character. Left column shows what the block
 * EVALUATES TO; that is the thing a beginner cannot see in the source.
 *
 * The error quoted in the lesson body is a real capture — see the .mdx.
 */

const rows = [
  {
    code: 'x + 1',
    kind: 'expression',
    yields: 'i32',
    verdict: 'ok',
    note: 'تعبير — بيتحوّل لقيمة، والقيمة دي هي ناتج الدالة',
  },
  {
    code: 'x + 1;',
    kind: 'statement',
    yields: '()',
    verdict: 'err',
    note: 'جملة — بتنفّذ وبتتخلص من الناتج، فالدالة بترجع ولا حاجة',
  },
];

const ROW = 74;
const H = 34 + rows.length * ROW + 10;
---

<figure class="st-figure">
  <div class="st-scroll">
    <svg
      viewBox={`0 0 640 ${H}`}
      width="640"
      height={H}
      role="img"
      aria-label="الفاصلة المنقوطة: من غيرها السطر تعبير وقيمته من نوع i32 فالدالة بترجعها، ومعاها السطر جملة وقيمتها الوحدة الفارغة فالدالة مش بترجع حاجة"
      class="st-svg"
    >
      <text x="14" y="18" class="st-head">السطر الأخير في الدالة</text>
      <text x="300" y="18" class="st-head">قيمته</text>
      <text x="430" y="18" class="st-head">النتيجة</text>

      {rows.map((r, i) => {
        const y = 34 + i * ROW;
        const ok = r.verdict === 'ok';
        return (
          <>
            <rect x="14" y={y} width="230" height="34" rx="3" class={`st-box is-${r.verdict}`} />
            <text x="26" y={y + 22} class="st-code">{r.code}</text>

            <text x="26" y={y + 56} class="st-note">{r.note}</text>

            <line x1="248" y1={y + 17} x2="292" y2={y + 17} class={`st-arrow is-${r.verdict}`} />
            <text x="300" y={y + 22} class={`st-yield is-${r.verdict}`}>{r.yields}</text>

            <text x="430" y={y + 22} class={`st-verdict is-${r.verdict}`}>
              {ok ? '✓ بيترجم' : '✕ E0308'}
            </text>
            <text x="430" y={y + 40} class="st-kind">{r.kind}</text>
          </>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <code dir="ltr">()</code> اسمها <strong>الوحدة</strong> — نوع قيمته الوحيدة
    هي "ولا حاجة". دالة معلنة إنها بترجع <code dir="ltr">i32</code> وبترجع
    <code dir="ltr">()</code> مش بتترجم، وده معنى رسالة
    <code dir="ltr">E0308</code>.
  </figcaption>
</figure>

<style>
  .st-figure { margin-block: var(--sp-6); margin-inline: 0; }
  .st-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-ui);
    background: var(--surface);
    padding: var(--sp-2);
  }
  .st-svg { display: block; max-inline-size: none; }
  .st-head { font-family: var(--font-sans); font-size: 12px; fill: var(--text-muted); }
  /* Code and type names are LTR regardless of the page direction. */
  .st-code, .st-kind, .st-yield { direction: ltr; unicode-bidi: isolate; }
  .st-code { font-family: var(--font-mono); font-size: 15px; fill: var(--text); }
  .st-note { font-family: var(--font-sans); font-size: 11px; fill: var(--text-muted); }
  .st-kind { font-family: var(--font-mono); font-size: 11px; fill: var(--text-muted); }
  .st-yield { font-family: var(--font-mono); font-size: 14px; font-weight: 700; }
  .st-yield.is-ok { fill: var(--mem-owned); }
  .st-yield.is-err { fill: var(--mem-error); }
  .st-verdict { font-family: var(--font-sans); font-size: 13px; font-weight: 600; }
  .st-verdict.is-ok { fill: var(--mem-owned); }
  .st-verdict.is-err { fill: var(--mem-error); }
  .st-box { fill: none; stroke-width: 2; }
  .st-box.is-ok { stroke: var(--mem-owned); }
  .st-box.is-err { stroke: var(--mem-error); stroke-dasharray: 5 3; }
  .st-arrow { stroke-width: 1.5; }
  .st-arrow.is-ok { stroke: var(--mem-owned); }
  .st-arrow.is-err { stroke: var(--mem-error); }
  figcaption {
    margin-block-start: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
</style>
