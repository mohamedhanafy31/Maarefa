---
/**
 * ModuleProgress.astro — Build-time position indicator.
 *
 * Renders "الدرس 3 من 9" using Western numerals 0-9 (CLAUDE.md C2).
 * No client JavaScript. No localStorage. No read tracking.
 * Purely a static build-time indicator derived from (module order, order).
 * (PLAN.md §5.3, CLAUDE.md C5)
 */

interface Props {
  /** 1-based position of this lesson among all lessons in the module. */
  position: number;
  /** Total number of lessons in this module (all, including drafts). */
  total: number;
}

const { position, total } = Astro.props;
---

<p class="module-progress" role="status" aria-label={`الدرس ${position} من ${total}`}>
  <span class="progress-label">الدرس</span>
  <!-- Western numerals only (CLAUDE.md C2). dir="ltr" keeps the numeral
       sequence rendering left-to-right within the RTL paragraph. -->
  <span class="progress-count" dir="ltr">{position} / {total}</span>
</p>

<style>
  .module-progress {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-block: 0 var(--sp-5);
  }

  .progress-count {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-ui);
    padding-inline: var(--sp-2);
    padding-block: 0.1em;
  }
</style>
