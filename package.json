    "check:budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "astro": "7.2.1",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/preact": "6.0.2",
    "@astrojs/rss": "4.0.19",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "rehype-autolink-headings": "7.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
