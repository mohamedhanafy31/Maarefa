{
  "name": "maarefa",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/emit-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "fonts:subset": "./scripts/subset-fonts.sh",
    "fonts:verify": "python3 scripts/verify-fonts.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:ci": "astro check && node scripts/check-logical-props.mjs && astro build && node scripts/emit-headers.mjs && node scripts/check-budget.mjs",
